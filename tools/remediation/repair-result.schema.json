{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "slice": {
      "type": "string",
      "minLength": 1
    },
    "failed_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "outcome": {
      "type": "string",
      "enum": [
        "fixed",
        "unresolved",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "command",
          "passed",
          "summary"
        ]
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocker": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "slice",
    "failed_attempt",
    "outcome",
    "summary",
    "actions",
    "validations",
    "changed_files",
    "blocker"
  ]
}
